local isFlipping = false

-- Функция полноценного сальто без помех от физики игры
local function doBackflip()
    if isFlipping then return end
    local character = player.Character
    if not character then return end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not humanoid or not hrp then return end

    isFlipping = true
    
    -- Временно отключаем штатный контроллер баланса, чтобы игра не мешала крутиться
    humanoid.PlatformStand = true
    hrp.Velocity = Vector3.new(hrp.Velocity.X, 42, hrp.Velocity.Z)

    local duration = 0.5 -- Время выполнения сальто
    local elapsed = 0
    local totalRotation = 0
    local targetRotation = 360

    local connection
    connection = RunService.RenderStepped:Connect(function(dt)
        elapsed = elapsed + dt
        local stepAngle = (dt / duration) * targetRotation
        totalRotation = totalRotation + stepAngle
        
        if elapsed < duration then
            -- Крутим персонажа назад по оси X
            hrp.CFrame = hrp.CFrame * CFrame.Angles(math.rad(-stepAngle), 0, 0)
        else
            -- Доворачиваем точно до ровного положения, чтобы не упасть набок
            local excess = totalRotation - targetRotation
            if excess > 0 then
                hrp.CFrame = hrp.CFrame * CFrame.Angles(math.rad(excess), 0, 0)
            end
            
            connection:Disconnect()
            -- Возвращаем нормальное состояние физики
            humanoid.PlatformStand = false
            isFlipping = false
        end
    end)
end

